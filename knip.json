{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    ".eloqnt/config.ts",
    "global.ts",
    "messages/*.d.json.ts",
    "sanity.types.ts",
    "components/ui/**",
    "lib/transforms/__tests__/mocks.ts"
  ],
  "ignoreBinaries": ["crowdin"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "playwright": {
    "config": ["playwright.config.ts", "playwright.components.config.ts"],
    "entry": [
      "e2e/**/*.spec.ts",
      "playwright/components/**/*.spec.ts",
      "playwright/gallery/{main,next-image,sanity-image,vite.config}.{ts,tsx}",
      "components/**/*.story.tsx"
    ]
  },
  "tags": ["-lintignore"]
}
