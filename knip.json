{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".eloqnt/config.ts",
    "global.ts",
    "messages/*.d.json.ts",
    "sanity.types.ts",
    "components/ui/**"
  ],
  "ignoreBinaries": ["crowdin"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "playwright": {
    "config": ["playwright.config.ts", "playwright.components.config.ts"],
    "entry": [
      "e2e/**/*.spec.ts",
      "playwright/components/**/*.spec.ts",
      "playwright/gallery/{main,router,sanity-image,vite.config}.{ts,tsx,mts}",
      "app/**/*.story.tsx",
      "components/**/*.story.tsx"
    ]
  },
  "tags": ["-lintignore"],
  "entry": [
    "app/routes/**/*.{ts,tsx}",
    "app/router.tsx",
    "app/start.ts",
    "workers/rooms/src/index.ts"
  ],
  "ignoreDependencies": ["cloudflare"]
}
