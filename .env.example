VITE_APP_URL=https://guesthouseosaka.com

VITE_GOOGLE_MAPS_API_KEY=
# Cloudflare's always-passing Turnstile test keys. Deployed builds get the real
# ones from Workers Builds and the Worker's secrets.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

SANITY_API_READ_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# LINE bot for room availability (see docs/line-bot.md). Off until all three are set.
# Editor token: the bot writes rooms' dates and runs Agent Actions.
SANITY_API_WRITE_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
