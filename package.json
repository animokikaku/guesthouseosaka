{
  "name": "guesthouseosaka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 next dev",
    "build": "NODE_NO_WARNINGS=1 next build",
    "start": "NODE_NO_WARNINGS=1 next start",
    "check": "next typegen && oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "crowdin:pull": "crowdin download translations",
    "crowdin:push": "crowdin upload sources",
    "eloqnt:lint": "eloqnt lint",
    "eloqnt:review": "eloqnt review",
    "eloqnt:translate": "eloqnt translate",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:components": "playwright test --config=playwright.components.config.ts",
    "test:components:ui": "playwright test --config=playwright.components.config.ts --ui",
    "test:e2e": "playwright test --project=local",
    "test:e2e:preview": "playwright test --project=preview",
    "test:e2e:ui": "playwright test --project=local --ui"
  },
