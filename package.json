{
  "name": "guesthouseosaka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun --env-file=.env vite build",
    "start": "vite preview --port 3000 --strictPort",
    "check": "bun check && oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "eloqnt:lint": "eloqnt lint",
    "eloqnt:review": "eloqnt review",
    "eloqnt:translate": "eloqnt translate",
    "studio:deploy": "sanity deploy --yes",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:components": "playwright test --config=playwright.components.config.ts",
    "test:e2e": "playwright test --project=local",
    "test:e2e:preview": "E2E_REAL_EMAIL=1 playwright test --project=preview",
    "deploy": "DEPLOY_ENV=production void deploy --platform cloudflare",
    "rooms:schedule:deploy": "bun --env-file=.env run rooms:schedule:cfn",
    "rooms:schedule:cfn": "aws cloudformation deploy --region ap-northeast-1 --stack-name guesthouseosaka-rooms-sync --template-file aws/rooms-sync.yaml --capabilities CAPABILITY_IAM --no-fail-on-empty-changeset --parameter-overrides SyncToken=$SYNC_TOKEN",
    "deploy:preview": "DEPLOY_ENV=preview vite build && wrangler preview -c dist/server/wrangler.json",
    "postinstall": "cn build --content '{app,components,lib}/**/*.{ts,tsx}' --out generated/cn-tables.ts --quiet"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lucide/lab": "^0.7.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@portabletext/react": "^8.0.1",
    "@ramka/react": "^0.0.1",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^8.11.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "^4.4.10",
    "@sanity/visual-editing": "^6.2.0",
    "@sanity/webhook": "^4.0.4",
    "@tanstack/react-form": "^2.0.0-alpha.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/redact": "^0.2.1",
    "@vis.gl/react-google-maps": "^1.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "embla-carousel-react": "^8.6.0",
    "groq": "^6.20.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "resend": "^6.34.1",
    "sanity": "^6.20.0",
    "sanity-plugin-internationalized-array": "^5.3.7",
    "schema-dts": "^2.1.0",
    "simple-icons": "^16.36.0",
    "styled-components": "^6.6.0",
    "use-intl": "4.14.9",
    "validator": "^13.15.35",
    "vaul-base": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eloqnt/cli": "^0.6.33",
    "@faker-js/faker": "^10.6.0",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "^1.64.1",
    "@sanity/vision": "^6.20.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "icu-minify": "4.14.9",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "monocart-coverage-reports": "^3.1.0",
    "oxc-transform-react": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "void": "1.3.0",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "@sanity/client": "$@sanity/client"
  },
  "packageManager": "bun@1.4.4"
}
