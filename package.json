{
  "name": "guesthouseosaka",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "studio"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && vite dev",
    "build": "vite build",
    "start": "vite preview --port 3000 --strictPort",
    "check": "bun check && oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "eloqnt:lint": "eloqnt lint",
    "eloqnt:review": "eloqnt review",
    "eloqnt:translate": "eloqnt translate",
    "studio:dev": "bun run --cwd studio dev",
    "studio:deploy": "bun run --cwd studio deploy",
    "typegen": "bun run --cwd studio typegen",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:components": "playwright test --config=playwright.components.config.ts",
    "test:e2e": "playwright test --project=local",
    "test:e2e:preview": "E2E_REAL_EMAIL=1 playwright test --project=preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ROOMS_DB --local",
    "deploy": "DEPLOY_ENV=production vite build && wrangler d1 migrations apply ROOMS_DB --remote && wrangler deploy && bun run cache:warm",
    "cache:warm": "bun scripts/warm-cache.mts",
    "rooms:schedule:deploy": "bun --env-file=.env run rooms:schedule:cfn",
    "rooms:schedule:cfn": "aws cloudformation deploy --region ap-northeast-1 --stack-name guesthouseosaka-rooms-sync --template-file aws/rooms-sync.yaml --capabilities CAPABILITY_IAM --no-fail-on-empty-changeset --parameter-overrides SyncToken=$SYNC_TOKEN",
    "deploy:preview": "DEPLOY_ENV=preview vite build && wrangler preview",
    "postinstall": "cn build --content '{app,components,lib}/**/*.{ts,tsx}' --out generated/cn-tables.ts --quiet"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@formatjs/intl-localematcher": "^0.10.1",
    "@lucide/lab": "^0.12.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@portabletext/react": "^8.0.1",
    "@ramka/react": "https://pkg.pr.new/arturbien/ramka/@ramka/react@d1cea80",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.2.0",
    "@sanity/webhook": "^4.0.4",
    "@tanstack/react-form": "^2.0.0-alpha.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@unpic/core": "^1.0.3",
    "@unpic/placeholder": "^0.1.2",
    "@vis.gl/react-google-maps": "^1.10.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "groq": "^6.22.0",
    "ky": "^2.2.0",
    "lucide-react": "^1.70.0",
    "negotiator": "^1.1.0",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8",
    "resend": "^6.37.0",
    "schema-dts": "^2.1.0",
    "simple-icons": "^16.37.0",
    "use-intl": "4.14.9",
    "validator": "^13.15.35",
    "vaul-base": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@eloqnt/cli": "^0.6.33",
    "@faker-js/faker": "^10.6.0",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/google.maps": "^3.66.10",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "icu-minify": "4.14.9",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "monocart-coverage-reports": "^3.2.1",
    "oxc-transform-react": "^0.157.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@sanity/client": "$@sanity/client"
  },
  "packageManager": "bun@1.4.4"
}
