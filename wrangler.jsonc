{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guesthouseosaka",
  "account_id": "5f8fd45c341a983aff5d6b8b01f88ee1",
  "main": "@tanstack/react-start/server-entry",
  // Production answers only on guesthouseosaka.com; Worker Previews keep their
  // workers.dev URLs. Wrangler turns both off once a custom domain is set.
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-10-25",
  // `node:async_hooks`, `node:crypto` and a populated `process.env`, which
  // `lib/env.ts` validates.
  "compatibility_flags": ["nodejs_compat"],
  // Workers Cache: Cloudflare serves responses from its cache in front of the
  // Worker, following their Cache-Control (see lib/cache-control.ts), so a
  // cached page never starts the Worker. Each deployed version starts empty.
  "cache": { "enabled": true },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // Secrets (`wrangler secret put`): SANITY_API_READ_TOKEN, RESEND_API_KEY,
  // TURNSTILE_SECRET_KEY, ROOMS_REVALIDATE_SECRET. Locally they come from
  // `.env.local`.
  // Only the production environment emails the houses (see contact.server.ts).
  "vars": { "DEPLOY_ENV": "development" },
  // Rooms the `guesthouseosaka-rooms` Worker syncs from shares.house, read-only
  // here (see docs/rooms.md and lib/rooms.server.ts). Bindings aren't inherited,
  // so the environments and previews below repeat it.
  "d1_databases": [
    {
      "binding": "ROOMS_DB",
      "database_name": "guesthouseosaka-rooms",
      // Must match workers/rooms/wrangler.jsonc.
      "database_id": "0924c651-cb96-42e8-9789-692c06b7baef"
    }
  ],
  // Worker Previews (`wrangler preview`) don't inherit the Worker's vars or
  // secrets: these mirror `env.preview`, which the build reads, and their
  // secrets are set with `wrangler preview base-config secret put`.
  "previews": {
    "vars": { "DEPLOY_ENV": "preview" },
    "d1_databases": [
      {
        "binding": "ROOMS_DB",
        "database_name": "guesthouseosaka-rooms",
        "database_id": "0924c651-cb96-42e8-9789-692c06b7baef"
      }
    ]
  },
  "env": {
    // Select at build time with CLOUDFLARE_ENV (see the `deploy` scripts), which
    // also picks the Sanity dataset: `production` reads live content, the others
    // `development` (see vite.config.ts).
    "preview": {
      // Previews live under the production Worker (see `deploy:preview`).
      "name": "guesthouseosaka",
      "vars": { "DEPLOY_ENV": "preview" },
      "d1_databases": [
        {
          "binding": "ROOMS_DB",
          "database_name": "guesthouseosaka-rooms",
          "database_id": "0924c651-cb96-42e8-9789-692c06b7baef"
        }
      ]
    },
    "production": {
      // Without a name, Wrangler would deploy `guesthouseosaka-production`, a
      // separate Worker without the secrets or the custom domain.
      "name": "guesthouseosaka",
      // Attaching it fails while another DNS record uses the hostname.
      // `www` redirects here through a Cloudflare Redirect Rule.
      "routes": [{ "pattern": "guesthouseosaka.com", "custom_domain": true }],
      "vars": { "DEPLOY_ENV": "production" },
      "d1_databases": [
        {
          "binding": "ROOMS_DB",
          "database_name": "guesthouseosaka-rooms",
          "database_id": "0924c651-cb96-42e8-9789-692c06b7baef"
        }
      ]
    }
  }
}
