{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // Runs the rooms sync on a schedule by calling `POST /sync` on the
  // `guesthouseosaka-rooms` Worker. See docs/rooms.md.
  "name": "guesthouseosaka-rooms-cron",
  "account_id": "5f8fd45c341a983aff5d6b8b01f88ee1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  // Every six hours (UTC).
  "triggers": { "crons": ["7 */6 * * *"] },
  "observability": { "enabled": true },
  // Secret: SYNC_TOKEN, the same value as on `guesthouseosaka-rooms`.
  // ROOMS: a separate Worker, so its fetch handler runs where its `placement`
  // says (near Tokyo); a Worker calling itself doesn't get placed.
  "services": [{ "binding": "ROOMS", "service": "guesthouseosaka-rooms" }]
}
