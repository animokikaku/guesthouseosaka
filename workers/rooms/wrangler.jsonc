{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Syncs shares.house room listings into D1, which the site reads through its
  // own binding to the same database. See docs/rooms.md.
  "name": "guesthouseosaka-rooms",
  "account_id": "5f8fd45c341a983aff5d6b8b01f88ee1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  // Serves `POST /sync`, the manual run, which needs the SYNC_TOKEN secret.
  "workers_dev": true,
  "preview_urls": false,
  // Every six hours (UTC).
  "triggers": { "crons": ["7 */6 * * *"] },
  // shares.house answers 403 outside Japan. Runs the fetch handler near Tokyo;
  // a cron runs wherever there's capacity, so it syncs through SELF instead.
  "placement": { "region": "aws:ap-northeast-1" },
  "observability": { "enabled": true },
  "vars": {
    // Listing pages (Japanese), synced in this order. Add one to sync it.
    "LISTING_URLS": [
      "https://shares.house/a_detail/q_10336/",
      "https://shares.house/a_detail/q_10698/",
      "https://shares.house/a_detail/q_10333/"
    ]
  },
  // Secrets: SYNC_TOKEN, and ROOMS_REVALIDATE_SECRET, shared with the site.
  // After a sync that changed rooms, purges the site's cached pages through
  // its `/api/revalidate-rooms`.
  // SELF: this Worker, so the cron's sync runs in the placed fetch handler.
  "services": [
    { "binding": "SITE", "service": "guesthouseosaka" },
    { "binding": "SELF", "service": "guesthouseosaka-rooms" }
  ],
  "d1_databases": [
    {
      "binding": "ROOMS_DB",
      "database_name": "guesthouseosaka-rooms",
      // The site's wrangler.jsonc repeats it.
      "database_id": "0924c651-cb96-42e8-9789-692c06b7baef",
      "migrations_dir": "migrations"
    }
  ]
}
