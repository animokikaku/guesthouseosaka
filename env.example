VITE_APP_URL=https://guesthouseosaka.com

VITE_GOOGLE_MAPS_API_KEY=
# Cloudflare's always-passing Turnstile test keys. Deployed builds get the real
# ones from Workers Builds and the Worker's secrets.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

SANITY_API_READ_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional. Signs Sanity's publish webhook (see docs/sanity-workflow.md).
SANITY_WEBHOOK_SECRET=
# Optional. Authorizes the room sync; `bun run rooms:schedule:deploy` sends it
# to the schedule, so it must match the Worker's secret (see docs/rooms.md).
SYNC_TOKEN=
